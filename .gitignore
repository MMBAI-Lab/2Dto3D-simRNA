# Internal documentation (not redistributable)
docs/

# SimRNA academic distribution — must be downloaded from the official site,
# not redistributed here. This includes the statistical-potential data/ dir.
SimRNA_64bitIntel_Linux/

# Runtime symlink to SimRNA's data directory (created per-run inside a run dir)
data
**/data

# Run inputs: track ONLY the single reference example. Any other per-run
# directory under inputs/ is local-only.
inputs/*
!inputs/example/
!inputs/example/**

# Run outputs: track ONLY the reference example's post-processed results,
# and drop the bulky trajectory files from it.
results/*
!results/example/
!results/example/**
*.trafl

# Re-assert the data-symlink exclusion: the results/example/** negation above
# would otherwise re-include the per-run `data` symlinks, which point at an
# absolute local path inside the (non-redistributable) SimRNA distribution.
results/example/**/data
results/example/data

# Branded DOCX renders of the Markdown reports. Regenerable at any time with
# `python3 scripts/build_report.py`, and the styling is derived from
# brand/tokens.json rather than a committed template — so the binaries are
# build output, not source.
*.docx

# Generated run artifacts
*.log
*.ss_detected
nohup.out
core.*

# Python bytecode
__pycache__/
*.pyc
*.pyo

# Editor / OS
.DS_Store
.vscode/
.idea/
*.swp
*~
