{
  "name": "danslab-brand",
  "color": {
    "black": "#000000",
    "ink": "#0b0b0c",
    "graphite": "#3a3b3f",
    "slate": "#6b6d72",
    "ash": "#9a9ca1",
    "mist": "#d9dadd",
    "paper": "#f7f6f4",
    "white": "#ffffff",
    "red": "#ce1b27",
    "redDark": "#7d1015",
    "logoRed": "#e5322e"
  },
  "font": {
    "serif": "\"IBM Plex Serif\", Georgia, serif",
    "sans": "\"IBM Plex Sans\", system-ui, sans-serif",
    "mono": "\"IBM Plex Mono\", ui-monospace, monospace"
  },
  "type": {
    "display": 84,
    "title": 64,
    "subtitle": 44,
    "body": 34,
    "caption": 24,
    "trackingKicker": "0.2em",
    "note": "px values are the 1920x1080 deck reference; scale down for web/UI"
  },
  "grid": {
    "size": 60,
    "lineDark": "rgba(255,255,255,0.12)",
    "lineLight": "rgba(0,0,0,0.04)"
  },
  "radius": 0,
  "surfaces": {
    "dark": { "bg": "#000000", "text": "#ffffff", "muted": "#9a9ca1", "grid": "lineDark" },
    "light": { "bg": "#ffffff", "text": "#0b0b0c", "muted": "#6b6d72", "grid": "lineLight" }
  },
  "logo": {
    "dark": "assets/danslab-logo-dark.svg",
    "light": "assets/danslab-logo-light.svg",
    "atomColor": "#e5322e",
    "minWidthPx": 88,
    "minWidthMm": 18,
    "rules": ["do not recolor the mark", "do not recolor the atom", "do not rotate or skew", "no shadows or effects"]
  }
}
